{
  "name": "olympiad-atlas-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "vars": {
    "FRONTEND_ORIGIN": "https://2319bli.github.io",
    "GOOGLE_CLIENT_ID": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "olympiad-atlas",
    "database_id": "REPLACE_WITH_CLOUDFLARE_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
